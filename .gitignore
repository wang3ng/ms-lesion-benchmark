# Local experiment dumps. Commit summaries in docs, not volume outputs.
results/**
!results/.gitkeep
!results/README.md
# Midpoint report (summary stats and training curves only; no images or masks).
!results/midpoint/
!results/midpoint/**
# E1 cross-validation report: markdown, figures, aggregate tables. Predictions,
# per-lesion lists, fold CSVs and test predictions stay local.
!results/E1/
!results/E1/cv_summary.md
!results/E1/figures/
!results/E1/figures/**
!results/E1/tables/
!results/E1/tables/**
# E2 comparison report (same rule: markdown, figures, aggregate tables only)
!results/E2/
!results/E2/cv_summary.md
!results/E2/figures/
!results/E2/figures/**
!results/E2/tables/
!results/E2/tables/**
!results/test/
!results/test/summary.md
!results/test/figures/
!results/test/figures/**
!results/test/tables/
!results/test/tables/**

# Notebook scratch
.ipynb_checkpoints/

# Third-party code (cloned; upstream commit recorded in experiments/E7/README.md)
third_party/
